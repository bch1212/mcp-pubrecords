# Halverson IQ Data — environment variables
# Copy to .env and fill in real values locally. Never commit .env.

# Required to issue customer API keys (POST /admin/keys) and to promote a
# key onto the paid tier (POST /billing/upgrade). The server fails closed
# with HTTP 403 when this is unset, blank, or does not match X-Admin-Token.
PUBRECORDS_ADMIN_TOKEN=

# SAM.gov API key for federal contract tools (search_contracts,
# get_contract_details, search_awards). Apply for your own key at
# https://sam.gov. Read only from this variable. Leave blank until set.
SAM_API_KEY=

# Optional: bump cache TTL (seconds). Default 86400 (24h).
PUBRECORDS_CACHE_TTL=86400

# Optional: path to SQLite cache + key store. Default ./pubrecords_cache.db
PUBRECORDS_DB_PATH=./pubrecords_cache.db

# Optional: User-Agent string for SEC EDGAR (SEC requires an identifying UA).
PUBRECORDS_SEC_USER_AGENT="Halverson IQ Data contact@example.com"

# Optional: CourtListener token (anonymous works but is rate limited).
COURTLISTENER_TOKEN=

# Optional: OpenCorporates API token (anonymous is limited to about 50/month).
OPENCORPORATES_TOKEN=

# Server port (Railway sets this automatically).
PORT=8000
