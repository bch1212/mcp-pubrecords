{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.bch1212/pubrecords",
  "description": "Halverson IQ Data: public records, grants, and federal contracts.",
  "repository": {
    "url": "https://github.com/bch1212/mcp-pubrecords",
    "source": "github"
  },
  "version": "0.2.0",
  "websiteUrl": "https://github.com/bch1212/mcp-pubrecords",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp-pubrecords-production.up.railway.app/mcp/",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Per-user API key. One key covers every tool on this server.",
          "isSecret": true,
          "isRequired": true
        }
      ]
    }
  ]
}
